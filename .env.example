# App
APP_NAME=VolunteerHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database: Neon (cloud PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=ep-xxxxx.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=volunteerhub
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_SSLMODE=require

# Uploaded images are saved in storage/app/public
FILESYSTEM_DISK=public
